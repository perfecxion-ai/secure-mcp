{
  "name": "@perfecxion/secure-mcp-server",
  "version": "2.0.0-alpha.1",
  "description": "Experimental MCP runtime for approved tools, explicit access policies, bounded execution, and audit events",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "secure-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "examples",
    "docs/THREAT_MODEL.md",
    "docs/OPERATIONS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "eslint src tests scripts --max-warnings=0",
    "test": "node --import tsx --test --test-concurrency=4 tests/*.test.ts",
    "test:security": "node --import tsx --test tests/security.test.ts tests/http.test.ts tests/http-limits.test.ts tests/api.test.ts",
    "test:ci": "npm test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "test:package": "node scripts/package-smoke.mjs",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build",
    "format": "prettier --write src tests scripts package.json tsconfig*.json eslint.config.js .github examples",
    "format:check": "prettier --check src tests scripts package.json tsconfig*.json eslint.config.js .github examples",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=src/*.ts tests/*.test.ts",
    "test:oauth": "node labs/oauth/verify.mjs"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/perfecxion-ai/secure-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "authorization",
    "audit"
  ],
  "author": "perfecxion-ai",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "mcpName": "io.github.perfecxion-ai/secure-mcp",
  "os": [
    "linux"
  ]
}
